// 履歴表示関数
function renderHistory(){

    const ul = document.getElementById("historyList");
    ul.innerHTML = "";

    historyFolders.forEach((folder,folderIndex)=>{

        let folderLi = document.createElement("li");
        folderLi.textContent = "📁 " + folder.name;
        folderLi.style.fontWeight = "bold";
        ul.appendChild(folderLi);

        let innerUl = document.createElement("ul");

        folder.history.forEach((snap,snapIndex)=>{

            let li = document.createElement("li");

            let flatBoard = snap.board.flat().join(" ");

            li.textContent =
                `${snapIndex+1}: T${snap.TATE} Y${snap.YOKO} ${snap.turn}`;

            li.style.cursor = "pointer";

            li.onclick = ()=>{
                loadFromFolder(folderIndex, snapIndex);
            };

            innerUl.appendChild(li);
        });

        ul.appendChild(innerUl);
    });
}

