function checkWin(){
    const dr=[0,1,1,1];
    const dc=[1,0,1,-1];

    for(let r=0;r<TATE;r++){
        for(let c=0;c<YOKO;c++){
            let p=board[r][c];
            if(p==="."||p==="#") continue;

            for(let d=0;d<4;d++){
                let count=1;
                for(let k=1;k<REN;k++){
                    let nr=r+dr[d]*k;
                    let nc=c+dc[d]*k;
                    if(nr<0||nr>=TATE||nc<0||nc>=YOKO) break;
                    if(board[nr][nc]===p) count++;
                    else break;
                }
                if(count===REN) return true;
            }
        }
    }
    return false;
}

function isFull(){
    for(let r=0;r<TATE;r++)
        for(let c=0;c<YOKO;c++)
            if(board[r][c]===".") return false;
    return true;
}

function sleep(ms){
    return new Promise(resolve => setTimeout(resolve, ms));
}

// シリアライズ化関数
function serializeBoard(){

    let flatBoard = board.flat().join(" ");

    return `TATE ${TATE}, YOKO ${YOKO}, TURN ${turn}, REN ${REN}, BOARD ${flatBoard}`;
}

