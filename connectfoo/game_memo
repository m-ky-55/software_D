function drawBoard(){
    let btnDiv = document.getElementById("columnButtons");
    let boardDiv = document.getElementById("board");

    btnDiv.style.gridTemplateColumns = `repeat(${YOKO}, 40px)`;
    boardDiv.style.gridTemplateColumns = `repeat(${YOKO}, 40px)`;

    btnDiv.innerHTML = "";
    boardDiv.innerHTML = "";

    // ▼ ボタン生成
    for(let c=0;c<YOKO;c++){
        let btn = document.createElement("button");
        btn.classList.add("colBtn");
        btn.textContent = "▼";
        btn.onclick = ()=>dropPiece(c);

        if(gameOver){
            btn.disabled = true;
            btn.style.background = "#999";
            btn.style.cursor = "not-allowed";
        }

        btnDiv.appendChild(btn);
    }

    // for(let c=0;c<YOKO;c++){
    //     let btn = document.createElement("button");
    //     btn.classList.add("colBtn");
    //     btn.textContent = "▼";
    //     btn.onclick = ()=>dropPiece(c);
    //     btnDiv.appendChild(btn);
    // }

    // 盤面生成
    for(let r=0;r<TATE;r++){
        for(let c=0;c<YOKO;c++){
            let cell = document.createElement("div");
            cell.classList.add("cell");

            if(board[r][c]==="O") cell.classList.add("O");
            if(board[r][c]==="X") cell.classList.add("X");
            if(board[r][c]==="#") cell.classList.add("hole");

            boardDiv.appendChild(cell);
        }
    }
    document.getElementById("turnInfo").textContent =
        `Player ${turn} の手番`;
}

async function dropPiece(col){

    if(gameOver) return;

    let targetRow = -1;

    // 最終着地点を探す
    for(let r=TATE-1;r>=0;r--){
        if(board[r][col] === "#") continue;
        if(board[r][col] === "."){
            targetRow = r;
            break;
        }
    }

    if(targetRow === -1) return;

    gameOver = true; // アニメ中ロック

    // 上から順に仮表示
    for(let r=0; r<=targetRow; r++){

        if(board[r][col] === "#") continue;

        drawBoard(); // 一旦通常描画

        // 仮描画用
        let boardDiv = document.getElementById("board");
        let index = r * YOKO + col;
        let cell = boardDiv.children[index];
        cell.classList.add(turn);

        await new Promise(res => setTimeout(res, 50));
    }

    // 正式に配置
    board[targetRow][col] = turn;

    gameOver = false;

    drawBoard();

    // 勝敗判定
    if(checkWin()){
        gameOver = true;
        alert(`Player ${turn} の勝利！`);
        return;
    }

    if(isFull()){
        gameOver = true;
        alert("引き分け！");
        return;
    }

    turn = (turn==="O")?"X":"O";
    drawBoard();
    saveSnapshot();

}

