function loadFromFolder(folderIndex, snapIndex){

    const data = historyFolders[folderIndex].history[snapIndex];

    TATE = data.TATE;
    YOKO = data.YOKO;
    REN  = data.REN;
    board = JSON.parse(JSON.stringify(data.board));
    turn = data.turn;

    currentGameIndex = folderIndex;

    gameOver = false;     // ← ここでゲーム再開
    startMode = "load";
    document.getElementById("startMenu").style.display = "none";
    document.getElementById("gameArea").style.display = "flex";

    drawBoard();
}

