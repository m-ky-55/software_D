function startGame(){

    console.log("startMode:", startMode);

     if(startMode !== "new") return;
    // if(startMode !== "new"){
    //     alert("新規ゲーム開始を選択してください");
    //     return;
    // }
    gameOver = false;
    YOKO = parseInt(document.getElementById("yoko").value);
    TATE = parseInt(document.getElementById("tate").value);
    REN  = parseInt(document.getElementById("ren").value);

    // 最大値を制限
    let maxRen = Math.min(TATE, YOKO);
    if(REN > maxRen){
        REN = maxRen;
        document.getElementById("ren").value = maxRen;
    }

    let holeRate = parseInt(document.getElementById("holeRate").value);

    board = Array.from({length:TATE},()=>Array(YOKO).fill("."));

    let holeCount = Math.floor(TATE*YOKO*holeRate/100);
    let placed = 0;

    while(placed < holeCount){
        let r = Math.floor(Math.random()*TATE);
        let c = Math.floor(Math.random()*YOKO);

        if(board[r][c] === "."){
            board[r][c] = "#";
            placed++;
        }
    }

    turn = "O";

    const newGame = {
        id: Date.now(),
        name: "Game " + (historyFolders.length + 1),
        history: []
    };

    historyFolders.push(newGame);
    currentGameIndex = historyFolders.length - 1;

    localStorage.setItem("historyFolders", JSON.stringify(historyFolders));

    saveSnapshot();   // ← 追加（重要）
    document.getElementById("startMenu").style.display = "none";
    document.getElementById("newGameSettings").style.display = "none";
    document.getElementById("gameArea").style.display = "flex";

    renderHistory();
    drawBoard();
}

