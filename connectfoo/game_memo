let historyList = [];
let historyFolders = [];
let currentGameIndex = -1;

function saveSnapshot(){

    if(currentGameIndex === -1) return;

    const snapshot = {
        TATE,
        YOKO,
        REN,
        board: JSON.parse(JSON.stringify(board)),
        turn
    };

    historyFolders[currentGameIndex].history.push(snapshot);

    localStorage.setItem("historyFolders", JSON.stringify(historyFolders));

    renderHistory();
}

